# Knowledge Base Cruvels - Configuration Environment Variables

# Database Connection (PostgreSQL Canonical Storage)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://localhost:55440/kb_cruvels
# Fallback SQLite for lightweight/testing environments if needed:
# DATABASE_URL=sqlite:///./data/kb_cruvels.db

# Data Paths
KB_DATA_ROOT=./data

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=Knowledge Base Cruvels - Indian Legal Knowledge Platform
API_VERSION=v1
API_PREFIX=/v1
DEBUG=false
LOG_LEVEL=INFO

# Upstream Dataset Configuration
UPSTREAM_HF_DATASET=vaquill/open-india-law
UPSTREAM_SNAPSHOT=v2026.08
UPSTREAM_COMMIT=58ea6d8b6859f8039ee68dff5af636f787b02463
# Hugging Face Access Token (required for downloading gated upstream parquet directly from HF)
HF_TOKEN=

# Ingestion Batching & Performance Settings
INGESTION_BATCH_SIZE=1000
MAX_WORKERS=4
VERIFY_HASHES=true
STRICT_VALIDATION=true
